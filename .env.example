# ───────────────────────────── Orvia environment ─────────────────────────────
# Copy to .env for local development. In production set real environment variables / AWS Secrets Manager.
# Secrets below are used by the API and worker ONLY and are never sent to the browser.

NODE_ENV=development                 # development | test | production
APP_ENV=development                  # development | test | staging | production  (mock providers are forbidden in production)
LOG_LEVEL=info

# ── Infrastructure ──
MONGODB_URI=mongodb://127.0.0.1:27017/orvia
REDIS_URL=                           # optional: shared rate limits & cache; the platform degrades gracefully without it
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false                    # true behind a load balancer / CDN (then client IPs come from X-Forwarded-For)
RATE_LIMIT_PER_MINUTE=600            # global per-client-IP budget; auth/search/checkout have stricter limits

# ── Security ──
JWT_SECRET=                          # >= 32 random chars (openssl rand -hex 32). Required in production.
ENCRYPTION_KEY=                      # 32-byte hex for encrypting stored credentials (openssl rand -hex 32)
METRICS_TOKEN=                       # optional bearer token protecting /metrics
COOKIE_SECURE=                       # defaults to true in staging/production

# ── Provider modes (mock/log are DEV ONLY; production requires live) ──
SUPPLIER_MODE=mock                   # mock | live
PAYMENT_MODE=mock                    # mock | live
ADS_MODE=mock                        # mock | live
NOTIFY_MODE=log                      # log | live
MOCK_TIME_SCALE=600                  # dev: 1 real second = N simulated seconds of mock shipping time
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret

# ── AI ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Payments ──
PAYMENT_SECRET=your_payment_secret_here          # alias reference for the provider secret(s) below
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Suppliers ──
SUPPLIER_API_KEY=your_supplier_api_key_here       # alias reference for the supplier credential(s) below
CJ_API_KEY=
CJ_API_SECRET=

# ── Advertising ──
AD_API_KEY=your_ad_api_key_here
AD_API_SECRET=your_ad_api_secret_here
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Notifications ──
EMAIL_PROVIDER_KEY=
EMAIL_FROM=Orvia <orders@orvia.example>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Object storage / images (REQUIRED in production: provider=s3, bucket, https CDN) ──
OBJECT_STORAGE_PROVIDER=local        # local (dev only) | s3 (any S3-compatible: AWS, R2, MinIO, Spaces)
OBJECT_STORAGE_BUCKET=               # required when s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=             # S3-compatible endpoint; omit for AWS S3
OBJECT_STORAGE_ACCESS_KEY=           # omit on AWS when an IAM role provides credentials
OBJECT_STORAGE_SECRET=
CDN_BASE_URL=                        # required in production, https, serves the bucket
LOCAL_MEDIA_DIR=.media               # dev only
MEDIA_MAX_BYTES=10000000
MEDIA_MIN_DIMENSION=500

# ── AWS (Terraform / deploy tooling) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Safety / legal / crawler ──
ALLOW_PRIVATE_FETCH=false            # tests/dev only; production refuses to start if true (SSRF guard)
LEGAL_REVIEW_REQUIRED=true           # keep true until counsel reviewed legal pages; blocks the launch gate
MARKET_CRAWLER_CONTACT=https://your-domain.example/bot   # shown in the crawler User-Agent; set a real contact URL

# ── Worker ──
WORKER_CONCURRENCY=4
WORKER_PORT=4100
SCHEDULER_ENABLED=true
SEED_ON_START=false                  # dev only; forbidden in production
