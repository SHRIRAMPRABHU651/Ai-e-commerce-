# ───────────────────────────── Orvia environment ─────────────────────────────
# Copy to .env for local development. In production set real environment variables / AWS Secrets Manager.
# Secrets below are used by the API and worker ONLY and are never sent to the browser.

NODE_ENV=development                 # development | test | production
APP_ENV=development                  # development | test | staging | production  (mock providers are forbidden in production)
LOG_LEVEL=info

# ── Infrastructure ──
MONGODB_URI=mongodb://127.0.0.1:27017/orvia
REDIS_URL=                           # optional: shared rate limits & cache; the platform degrades gracefully without it
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false                    # true behind a load balancer / CDN (then client IPs come from X-Forwarded-For)
RATE_LIMIT_PER_MINUTE=600            # global per-client-IP budget; auth/search/checkout have stricter limits

# ── Security ──
JWT_SECRET=                          # >= 32 random chars (openssl rand -hex 32). Required in production.
ENCRYPTION_KEY=                      # 32-byte hex for encrypting stored credentials (openssl rand -hex 32)
METRICS_TOKEN=                       # optional bearer token protecting /metrics
COOKIE_SECURE=                       # defaults to true in staging/production

# ── Provider modes (mock/log are DEV ONLY; production requires live) ──
SUPPLIER_MODE=mock                   # mock | live
# SUPPLIER_ENFORCE_VERIFICATION=true  # only route orders to approved+production_ready suppliers (default: true in production, false elsewhere)
PAYMENT_MODE=mock                    # mock | live
ADS_MODE=mock                        # mock | live
NOTIFY_MODE=log                      # log | live
MOCK_TIME_SCALE=600                  # dev: 1 real second = N simulated seconds of mock shipping time
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret

# ── AI ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Payments ──
PAYMENT_SECRET=your_payment_secret_here          # alias reference for the provider secret(s) below
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Suppliers ──
SUPPLIER_API_KEY=your_supplier_api_key_here       # alias reference for the supplier credential(s) below
CJ_API_KEY=
CJ_API_SECRET=

# ── Advertising ──
AD_API_KEY=your_ad_api_key_here
AD_API_SECRET=your_ad_api_secret_here
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- Server-side conversion events (UNVERIFIED against live accounts; see docs/ORVIA_MARKETING_AND_TRACKING.md) ---
EVENTS_MODE=log                      # log | live (production refuses log while EVENTS_PROVIDERS is set)
EVENTS_PROVIDERS=                    # comma list: meta,tiktok,ga4,google_ads
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=              # Events Manager > Settings > Conversions API (NOT the Marketing API token)
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_VERSION=v21.0
TIKTOK_PIXEL_CODE=
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_EVENTS_TEST_CODE=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GOOGLE_ADS_PURCHASE_CONVERSION_ACTION_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
EVENTS_EMAIL_DAILY_LIMIT=2000        # max marketing emails per UTC day across all campaigns
# Browser pixels (public; the loader only runs after consent). Set in the web app environment.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ── Notifications ──
EMAIL_PROVIDER_KEY=
EMAIL_FROM=Orvia <orders@orvia.example>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Object storage / images (REQUIRED in production: provider=s3, bucket, https CDN) ──
OBJECT_STORAGE_PROVIDER=local        # local (dev only) | s3 (any S3-compatible: AWS, R2, MinIO, Spaces)
OBJECT_STORAGE_BUCKET=               # required when s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=             # S3-compatible endpoint; omit for AWS S3
OBJECT_STORAGE_ACCESS_KEY=           # omit on AWS when an IAM role provides credentials
OBJECT_STORAGE_SECRET=
CDN_BASE_URL=                        # required in production, https, serves the bucket
LOCAL_MEDIA_DIR=.media               # dev only
MEDIA_MAX_BYTES=10000000
MEDIA_MIN_DIMENSION=500

# ── AWS (Terraform / deploy tooling) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Safety / legal / crawler ──
ALLOW_PRIVATE_FETCH=false            # tests/dev only; production refuses to start if true (SSRF guard)
LEGAL_REVIEW_REQUIRED=true           # keep true until counsel reviewed legal pages; blocks the launch gate
MARKET_CRAWLER_CONTACT=https://your-domain.example/bot   # shown in the crawler User-Agent; set a real contact URL

# ── FX rates (finance) ──
# frankfurter = free, no key, ECB reference rates (https://frankfurter.dev). exchangerate_api = keyed (needs FX_API_KEY).
# static = fixed dev/test table; production REFUSES to start with it. Unset = frankfurter in production, static elsewhere.
FX_PROVIDER=
FX_API_URL=                          # optional base-URL override
FX_API_KEY=                          # only for exchangerate_api
FX_WARN_HOURS=30                     # rates older than this are flagged stale in the admin
FX_HARD_LIMIT_HOURS=96               # production refuses to price new orders from older rates (admin override in /admin/finance)
FX_REFRESH_MINUTES=360

# ── Worker ──
WORKER_CONCURRENCY=4
WORKER_PORT=4100
SCHEDULER_ENABLED=true
SEED_ON_START=false                  # dev only; forbidden in production
